# Copy to .env (loaded by client/main.py).
# You only need the key(s) for the provider you actually use; nothing here is
# needed for `inspect`, `workflow daily-brief` or `workflow capture-todos`.

ANTHROPIC_API_KEY=sk-ant-...
# AGENT_PROVIDER=anthropic            # anthropic | openai | gemini (or use --provider)
# ANTHROPIC_MODEL=claude-opus-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.1
# Local model (Ollama / LM Studio / vLLM — OpenAI-compatible endpoint):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3
# OPENAI_API_KEY=ollama               # any non-empty value

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-pro

# Freeze "today" so the demo data lines up (calendar/today, overdue tasks)
WORKSPACE_TODAY=2026-08-23
